# HTTP
PORT=8787
CORS_ORIGIN=http://localhost:4321

# Postgres (Drizzle) — required for accounts + chat (see docker-compose.yml)
DATABASE_URL=postgres://chatforge:chatforge@localhost:5432/chatforge

# better-auth (accounts + passkeys)
BETTER_AUTH_SECRET=change-me-32+chars-in-production
BETTER_AUTH_URL=http://localhost:8787
# Passkey/WebAuthn: rpID = host (no scheme), origin = the web app URL (no trailing slash)
PASSKEY_RPID=localhost
PASSKEY_ORIGIN=http://localhost:4321

# S3-compatible object storage for E2E-encrypted blobs (MinIO local / Backblaze B2 prod)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=chatforge
S3_ACCESS_KEY=
S3_SECRET_KEY=
