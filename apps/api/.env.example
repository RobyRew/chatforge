# HTTP
PORT=8787
CORS_ORIGIN=http://localhost:4321

# Postgres (Drizzle) — required for accounts + chat (see docker-compose.yml)
DATABASE_URL=postgres://chatforge:chatforge@localhost:5432/chatforge

# Auth via Logto (central SSO IdP) — Traditional Web (confidential client, server-side session).
# Identity only — passwords/passkeys/social/MFA live in Logto. The browser holds only the opaque
# `cf_sid` cookie; access/ID tokens never reach client JS. See docs/auth-logto.md.
LOGTO_ENDPOINT=https://auth.robyrew.com
LOGTO_APP_ID=
LOGTO_APP_SECRET=
# Public origin used to build OIDC redirect URIs (behind Traefik, TLS terminated upstream). In the
# Logto app set redirect URI = <APP_BASE_URL>/api/auth/callback and post-sign-out = <APP_BASE_URL>.
APP_BASE_URL=http://localhost:4321

# First-run owner: the user who first signs in with this email is granted the 'owner' role (once).
ADMIN_EMAIL=owner@example.com

# S3-compatible object storage for chat attachments + avatars (MinIO on the VPS / Backblaze B2).
# Leave the keys blank to disable uploads entirely — the blob routes then answer 503 and the rest of
# the app is unaffected. In docker-compose these default to the bundled MinIO's root credentials.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chatforge
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Per-user storage quota in bytes (default 512 MB).
BLOB_QUOTA_BYTES=536870912

# Spotify "now playing" status (optional). Create an app at developer.spotify.com and add
# <APP_BASE_URL>/api/integrations/spotify/callback as a Redirect URI. Leave blank to disable —
# the integration routes then answer 503 and nothing else changes.
# Only the read-only `user-read-currently-playing` scope is requested; tokens are stored encrypted
# (AES-256-GCM, key derived from LOGTO_APP_SECRET) and never reach the browser.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
