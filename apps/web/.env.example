# API origin for better-auth + chat. Leave UNSET in dev — Vite proxies /api → :8787 same-origin
# (so the session cookie works over http). Set this only for a cross-origin production deploy.
# VITE_API_URL=https://api.chatforge.example
#
# Vite's dev proxy target (optional; defaults to http://localhost:8787):
# VITE_API_URL=http://localhost:8787
