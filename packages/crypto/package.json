{
  "name": "@chatforge/crypto",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Client-side E2E crypto: Argon2id key hierarchy, XChaCha20-Poly1305 blob sealing, BIP39 recovery, MLS (ts-mls) provider.",
  "exports": {
    ".": "./src/index.ts",
    "./mls": "./src/mls.ts",
    "./safety-number": "./src/safetyNumber.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@hpke/chacha20poly1305": "1.7.1",
    "@hpke/dhkem-x448": "1.7.0",
    "@hpke/hybridkem-x-wing": "0.6.1",
    "@hpke/ml-kem": "0.2.1",
    "@noble/ciphers": "2.1.1",
    "@noble/curves": "2.0.1",
    "@noble/post-quantum": "0.5.2",
    "@scure/bip39": "^1.5.0",
    "libsodium-wrappers-sumo": "^0.7.15",
    "ts-mls": "^1.6.2"
  },
  "devDependencies": {
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
