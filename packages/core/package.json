{
  "name": "@chatforge/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ChatForge conversion engine: plugin registry, lossless canonical pipeline, importers & exporters.",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts",
    "./transforms": "./src/transforms.ts",
    "./richtext": "./src/richtext.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@chatforge/types": "*",
    "fflate": "^0.8.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
